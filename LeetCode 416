class Solution {
public:
    bool fun(vector<int>& v, int ind, int sum, vector<vector<int>>& dp)
    {
        if(ind<0) return false;
        if(sum==0) return true;
        if(dp[sum][ind]!=-1)
            return dp[sum][ind];
        int take=0,leave=0;
        if(v[ind]<=sum)
            take=fun(v,ind-1,sum-v[ind],dp);
        leave=fun(v,ind-1,sum,dp);
        return dp[sum][ind]=take|| leave;
        
    }
    bool canPartition(vector<int>& v) {
        
        int sum=0;
        for(int i=0;i<v.size();i++)
            sum+=v[i];
        if(sum%2==1)
            return false;
        vector<vector<int>> dp(sum/2+1,vector<int>(v.size()+1,-1));
        return fun(v,v.size()-1,sum/2,dp);
    }
};
