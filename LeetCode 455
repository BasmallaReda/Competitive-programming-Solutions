class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        sort(g.rbegin(), g.rend());
        sort(s.rbegin(), s.rend());
        int cnt=0;
        for(int i=0;i<g.size() && cnt< s.size();i++)
        {
            if(s[cnt]<g[i])
                continue;
            else
                cnt++;
        }
        return cnt;
    }
};
