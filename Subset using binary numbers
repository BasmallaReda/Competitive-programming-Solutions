int SubSet(int* arr, int s)
{
    vector<int> ret(s);
    bool flag=false;
    for(int i=0;i<pow(2,s);i++){
        int n=i;
        vector<int> res;
        for(long long unsigned int j=0;n>0;j++)//0(0) 1(1) 2(10)
        {
            if(n&1)
                res.push_back(arr[j]);
            n=n/2;
        }
    }
}
