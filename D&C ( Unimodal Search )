int unimodalSearch(int A[], int low, int high) {
    if (low == high)
        return low;

    int mid = low + (high - low) / 2;

    if (A[mid] > A[mid - 1] && A[mid] > A[mid + 1])
        return mid;

    if (A[mid] > A[mid - 1])
        return unimodalSearch(A, mid + 1, high);
    else
        return unimodalSearch(A, low, mid - 1);
}
