class Solution {
public:
    bool lemonadeChange(vector<int>& bills) {
        vector<int> v={0,0};
        for(int i=0;i<bills.size();i++)
        {
            int ele = bills[i]-5;
            if(ele==5) v[1]++;//10s
            if(ele==0) v[0]++;//5s
            if(v[1] && ele>=10){
                v[1]--;
                ele-=10;
            }
            while(v[0] && ele){
                v[0]--;
                ele-=5;
            }
            if(ele) return false;
        }
        return true;
    }
};
