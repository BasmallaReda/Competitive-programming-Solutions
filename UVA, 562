//DP, Knapsack Style with some math
#include <iostream>
#include <vector>
#include <climits>
#include <bits/stdc++.h>
using namespace std;


int fun(vector<int>&v,int ind, int sum,vector<vector<int>>&dp )
{
    if(sum==0)
        return 0;
    if(ind<0)
        return 0;
    if(dp[ind][sum]!=-1)
        return dp[ind][sum];
    int take=0,leave=0;
    if(v[ind]<=sum)
        take= v[ind]+fun(v,ind-1,sum-v[ind], dp);
    leave= fun(v,ind-1, sum, dp);
    return dp[ind][sum]=max(take,leave);
}
int main()
{
    cin.tie(nullptr);
    ios_base::sync_with_stdio(false);
    int n;
    cin>>n;
    vector<int> v(n);
    bool flag=false;
    while(n--)
    {

        int k;
        cin>>k;
        vector<int >num(k);
        int sum=0;
        for(int i=0;i<k;i++)
        {
            cin>>num[i];
            sum+=num[i];
        }
        //cout<<"SUM= "<<sum<<endl;
        vector<vector<int>> dp(k+1,vector<int>(sum/2+5, -1));
        int p1=fun(num,k-1, sum/2+sum%2, dp);
        int p2=sum-p1;
        v[n]=abs(p1-p2);
        //cout<<"Parts: "<<p1<<" "<<p2<<endl;
    }

    reverse(v.begin(),v.end());
    for(int i=0;i<v.size();i++)
        cout<<v[i]<<endl;
    return 0;
}
