bool isPrime(int num) //O(n^0.5)
{
    if(num%2==0)
        return num==2;
    for(int j=3;j*j<=num;j+=2)
    {
        if(num%j==0)
            return false;
    }
    return true;
}

//recursion O(n)
void Prime(int n)
{
    int i=2;
    while(n>1)
    {
        if(n%i==0)
            return false;
        i++;
    }
    return true;
}

