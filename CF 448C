#include <iostream>
#include <vector>
#include <climits>
#include<algorithm>
#include <bits/stdc++.h>
using namespace std;
int minInd(vector<int>& v, int Start, int End)
{
    int j=Start;
    for(int i=Start;i<=End;i++)
    {
        if(v[i]<v[j])
            j=i;
    }
    return j;
}
int fun(vector<int> v, int Start, int End)
{
    if(End==Start)
        return 1;
    if(End<Start)
        return 0;
    int mn=v[minInd(v,Start,End)];
    for (int i = Start; i <= End; i++)
        v[i] -= mn;

    int hor = mn;
    int i = Start;

    while (i <= End)
    {
        if (v[i] == 0)
        {
            i++;
            continue;
        }

        int j = i;
        while (j <= End && v[j] > 0) j++;

        hor += fun(v, i, j - 1);
        i = j;
    }
    int ver=End-Start+1;
    return min(ver,hor);

}
int main()
{
    cin.tie(nullptr);
    ios_base::sync_with_stdio(false);
    int n;
    cin>>n;
    vector<int> v(n);
    for(int i=0;i<n;i++)
        cin>>v[i];
    cout<<fun(v, 0, n-1)<<"\n";
    return 0;
}
