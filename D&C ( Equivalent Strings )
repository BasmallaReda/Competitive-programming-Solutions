bool isEquivalent(string a, string b)
{
    if (a == b)
        return true;

    if (a.size() % 2 == 1)
        return false;

    int mid = a.size() / 2;

    string a1 = a.substr(0, mid);
    string a2 = a.substr(mid);

    string b1 = b.substr(0, mid);
    string b2 = b.substr(mid);

    return (isEquivalent(a1, b1) && isEquivalent(a2, b2)) ||
           (isEquivalent(a1, b2) && isEquivalent(a2, b1));
}
