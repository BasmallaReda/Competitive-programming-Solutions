int countPrimes(unsigned long  num) {
    vector<unsigned long > Primes(num, 0);
    int res=0;
    for(unsigned long i=2;i<num;i++)
    {
        if(Primes[i]==0)
        {
            res++;
            for(unsigned long j=i*i;j<num;j+=i)
                Primes[j]=1;
        }
    }
    return res;
}
