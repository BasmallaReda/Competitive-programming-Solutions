#include <iostream>
#include <vector>
#include <climits>
#include <bits/stdc++.h>
using namespace std;

int Max(vector<int>& v)//Bottom-Up
{
    vector<int> dp(v.size()+1,0);
    dp[0]=v[0];
    dp[1]=v[1];
    dp[2]=dp[0]+v[2];
    for(int i=3;i<v.size();i++)
    {
        dp[i]=v[i]+max(dp[i-2],dp[i-3]);
    }
    return dp[v.size()-1];
}

int fun(vector<int>& v, int ind, vector<int>&dp)
{
    if(ind+2>=v.size())
        return 0;
    int ch1, ch2=0;
    if(dp[ind+2]!=-1)
        return dp[ind+2];
    ch1=v[ind+2]+fun(v,ind+2, dp);
    if(ind+3<v.size())
        ch2=v[ind+3]+fun(v,ind+3, dp);
    return dp[ind+2]=max(ch1,ch2);
}
int main()
{
    int n;
    cin>>n;
    vector<int> v(n);
    for(int i=0;i<n;i++)
        cin>>v[i];
    vector<int> dp(n+1,-1);
    cout<<fun(v,-2, dp);
    return 0;
}
