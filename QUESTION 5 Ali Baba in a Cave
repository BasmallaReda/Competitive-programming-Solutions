// Normal Knapsack style with small while loop in inputs, Top-Down
#include <iostream>
#include <vector>
#include <climits>
#include <bits/stdc++.h>
using namespace std;

int Knapsack(vector<int>& wes,vector<int>& vals,int ind, int maxi, vector<vector<int>>& dp)
{
    if(ind<0 || maxi==0)
        return 0;

    if(dp[ind][maxi]!=-1)
        return dp[ind][maxi];
    int take=0,leave=0;
    if(wes[ind]<=maxi)
        take=vals[ind]+Knapsack(wes,vals,ind-1,maxi-wes[ind], dp);
    leave=Knapsack(wes,vals,ind-1,maxi, dp);
    return dp[ind][maxi]= max(take,leave);
}

int main()
{
    int n,val,we,in,maxi;
    cin>>n>>maxi;
    vector<int> v, w;
    for(int i=0;i<n;i++)
    {
        cin>>we>>val>>in;
        while(in--)
        {
            v.push_back(val);
            w.push_back(we);
        }
    }
    vector<vector<int>> dp(v.size(),vector<int>(maxi+1,-1));
    cout<<Knapsack(w,v,v.size()-1, maxi, dp);
    return 0;
}
