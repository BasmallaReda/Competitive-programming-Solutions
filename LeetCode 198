class Solution {
public:
    int helper(vector<int>& nums,int ind, vector<int>&dp)
    {
        if(ind<0)
            return 0;
        if(dp[ind]!=-1)
            return dp[ind];
        int ch1=nums[ind]+helper(nums,ind-2, dp);
        int ch2=helper(nums,ind-1,dp);
        return dp[ind]=max(ch1,ch2);
    }
    int rob(vector<int>& nums) {
        vector<int> dp(nums.size(),-1);
        return helper(nums,nums.size()-1, dp);
    }
};
