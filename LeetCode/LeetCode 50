class Solution {
public:
    double fun(double n, long long k) {
       if(k==0)
            return 1;
        double res=pow(n,k/2);
        if(k%2==1)
            return res*res*n; 
        return res*res; 
    }
    double myPow(double n, long long k) {
        if(n==1 || n==0)
            return n;
       if(k<0){
            return fun(1/n,-k);
        }
        else
            return fun(n, k);
    }
};
