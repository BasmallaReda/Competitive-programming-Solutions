class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {
        int n=intervals.size();
        sort(intervals.begin(), intervals.end());
        int ctr=0, s=intervals[n-1][1];
        for(int i=n-1;i>=0;i--)
        {
            if(intervals[i][1]<=s)//take it
                s=intervals[i][0];
            else
                ctr++;
        }
        return ctr;
    }
};
