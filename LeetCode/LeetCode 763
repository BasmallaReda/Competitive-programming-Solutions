class Solution {
public:
    vector<int> partitionLabels(string s){
        int n=s.size();
        vector<int> v;
        vector<int> freq(26,-1);
        for(int i=0;i<n;i++)
            freq[s[i]-'a']=i;//store the last index

        int start=-1, e=freq[s[0]-'a'];
        for(int i=0;i<n;i++)
        {
            e=max(e,freq[s[i]-'a']);
            if(e==i){
                v.push_back(e-start);
                start=i;
            }
        }
        return v;
    }
};
