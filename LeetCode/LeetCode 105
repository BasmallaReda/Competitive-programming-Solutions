/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    TreeNode* fun(vector<int>& preorder, vector<int>& inorder, int s1,int e1, int s2,int e2)
    {
        if(s1>e1 )
            return nullptr;
        if(s1==e1 )//only one node
            return new TreeNode(preorder[s1]);
        TreeNode* root=new TreeNode(preorder[s1]);
        int mid=s2;
        for(int i=s2;i<=e2;i++)//inorder handeling
        {
            if(inorder[i]==root->val)
            {
                mid=i;break;
            }
        }
        int leftSize=mid-s2;
        root->left=fun(preorder,inorder, s1+1,s1+leftSize, s2,mid-1);
        root->right=fun(preorder,inorder, s1+leftSize+1 ,e1, mid+1,e2);

        return root;
    }
    TreeNode* buildTree(vector<int>& preorder, vector<int>& inorder) {
        return fun(preorder, inorder, 0, preorder.size()-1, 0, inorder.size()-1);
    }
};
