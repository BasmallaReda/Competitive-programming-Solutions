#include <iostream>
#include <vector>
#include <climits>
#include<algorithm>
#include <bits/stdc++.h>
using namespace std;

int unimodelMax(vector<int>& v, int s, int e)
{

    if(s==e)
        return s;
    else if(s+1==e)//2 elements
        return (v[s]>v[s+1])?s:s+1;

    int mid=(s+e)/2;
    if(v[mid]>v[mid+1] && v[mid]>v[mid-1])
        return mid;

    return (v[mid-1]>v[mid])? unimodelMax(v,s,mid-1):unimodelMax(v,mid+1,e);
}

int unimodelMin(vector<int>& v, int s, int e)
{

    if(s==e)
        return s;
    else if(s+1==e)//2 elements
        return (v[s]<v[s+1])?s:s+1;

    int mid=(s+e)/2;
    if(v[mid]<v[mid+1] && v[mid]<v[mid-1])
        return mid;

    return (v[mid-1]<v[mid])? unimodelMin(v,s,mid-1):unimodelMin(v,mid+1,e);
}
int main()
{
    cin.tie(nullptr);
    ios_base::sync_with_stdio(false);
    int n;
    cin>>n;
    vector<int>X(n), Y(n);
    for(int i=0;i<n;i++)
        cin>>X[i]>>Y[i];
    int minX=0;
    int maxX=unimodelMax(X,0,n-1);
    int maxY=unimodelMax(Y,0,maxX);
    int minY=unimodelMin(Y,maxX,n-1);
    cout<<X[minX]<<" "<<X[maxX]<<" "<<Y[minY]<<" "<<Y[maxY]<<endl;
    return 0;

}
