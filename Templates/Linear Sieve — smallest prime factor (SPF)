
const int N = 1e6 + 9;

vector<int> lp(N, 0); // smallest prime factor
vector<int> primes;

void sieve() {
    for (int i = 2; i < N; i++) {
        if (lp[i] == 0) {
            lp[i] = i;
            primes.push_back(i);
        }

        for (int j = 0;
             j < (int)primes.size() &&
             1LL * i * primes[j] < N;
             j++) {

            lp[i * primes[j]] = primes[j];

            if (primes[j] == lp[i]) {
                break;
            }
        }
    }
}
