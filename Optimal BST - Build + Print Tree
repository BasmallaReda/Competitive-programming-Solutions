#include <bits/stdc++.h>
using namespace std;

// Node structure for BST
struct Node {
    int key;
    Node *left, *right;

    Node(int k) {
        key = k;
        left = right = nullptr;
    }
};

// Build tree using root table
Node* buildTree(vector<vector<int>>& root, int i, int j) {
    if (i > j) return nullptr;

    int r = root[i][j];
    Node* node = new Node(r);

    node->left = buildTree(root, i, r - 1);
    node->right = buildTree(root, r + 1, j);

    return node;
}

// Print tree (inorder)
void inorder(Node* root) {
    if (!root) return;
    inorder(root->left);
    cout << char('A' + root->key) << " ";
    inorder(root->right);
}

// Main OBST function
Node* optimalBST(vector<double>& p) {
    int n = p.size();

    vector<vector<double>> dp(n, vector<double>(n, 0));
    vector<vector<int>> root(n, vector<int>(n, 0));

    // prefix sum
    vector<double> pref(n + 1, 0);
    for (int i = 0; i < n; i++)
        pref[i + 1] = pref[i] + p[i];

    for (int i = 0; i < n; i++) {
        dp[i][i] = p[i];
        root[i][i] = i;
    }

    for (int len = 2; len <= n; len++) {
        for (int i = 0; i + len - 1 < n; i++) {
            int j = i + len - 1;

            dp[i][j] = 1e18;

            double sum = pref[j + 1] - pref[i];

            for (int k = i; k <= j; k++) {
                double left = (k > i) ? dp[i][k - 1] : 0;
                double right = (k < j) ? dp[k + 1][j] : 0;

                double cost = left + right + sum;

                if (cost < dp[i][j]) {
                    dp[i][j] = cost;
                    root[i][j] = k;
                }
            }
        }
    }

    return buildTree(root, 0, n - 1);
}

int main() {
    int n;
    cin >> n;

    vector<double> p(n);
    for (int i = 0; i < n; i++) {
        cin >> p[i];
    }

    Node* root = optimalBST(p);

    // Print inorder (should be sorted keys)
    inorder(root);
    cout << "\n";

    return 0;
}
