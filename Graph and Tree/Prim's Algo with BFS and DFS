typedef pair<int, int> ii;

int prim2(vector<vector<int>>& edges, vector<vector<int>>& edgesTaken)
{
    int n=edges.size();
    vector<bool> visited(n, false);
    vector<int> minKey(n, INT_MAX);//cost from unvisited to parent(visited)
    vector<int> parent(n, -1);//visited node actually
    minKey[0]=0;
    int wt=0;
    for(int cnt=0;cnt<n;cnt++)
    {
        int mini=INT_MAX, u=-1;
        for(int i=0;i<n;i++)
        {
            if(!visited[i] && minKey[i]<mini)
            {
                mini=minKey[i];
                u=i;
            }
        }

        if(u==-1) break;
        visited[u]=true;
        wt+=mini;

        if(parent[u] != -1)
            edgesTaken.push_back({parent[u], u});

        for(int i=0;i<n;i++)
        {
            if(!visited[i]&& edges[u][i] && edges[u][i]<minKey[i])
            {
                minKey[i]=edges[u][i];
                parent[i]=u;
            }
        }
    }
    return wt;
}
int prim(vector<vector<int>>& edges, vector<vector<int>>& edgesTaken)
{
    int n=edges.size();
    int Wt=0;
    priority_queue<ii, vector<ii>, greater<ii> > minHeap;

    vector<bool> visited(n,false);
    minHeap.push({0,0});

    while(!minHeap.empty()){
        ii res=minHeap.top();
        minHeap.pop();
        int u=res.first, v=res.second;
        if(visited[v]) continue;

        edgesTaken[u].push_back(v);
        edgesTaken[v].push_back(u);
        Wt+=edges[u][v];
        visited[v]=true;
        for(int i=0;i<n;i++)
        {
            if(edges[v][i] && !visited[i])
                minHeap.push({v, i});
        }
    }
    return Wt;
}
void DFS(const vector<vector<int>>& adj, vector<bool>& visited, int u)
{
    visited[u] = true;
    cout << u << " ";

    for (int v : adj[u])
    {
        if (!visited[v])
            DFS(adj, visited, v);
    }
}

void BFS(const vector<vector<int>>& adj,vector<bool>&visited, queue<int>& q)
{
    while (!q.empty())
    {
        int u = q.front();
        q.pop();
        cout << u << " ";
        for (int v : adj[u])
        {
            if (!visited[v]) {
                visited[v] = true;
                q.push(v);
            }
        }
    }
}

