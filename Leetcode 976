class Solution {
public:
    int fun(vector<int>& v)
    {
        sort(v.begin(),v.end());
        int m=0;
        for(int i=v.size()-1;i>1;i--)
        {
            for(int j=i-1;j>0;j--)
            {
                for(int k=j-1;k>=0;k--)
                {
                    if( v[k]+v[j]>v[i] && v[k]+v[i]>v[j] && v[i]+v[j]>v[k])
                    {
                        return v[k]+v[j]+v[i];
                    }
                    else 
                        break;
                }
            }
        }
        return m;
    }
    int largestPerimeter(vector<int>& nums) {
        return fun(nums);
    }
};

