#include <bits/stdc++.h>
using namespace std;

// Node structure
struct Node {
    char ch;        // valid only for leaf nodes
    int freq;
    Node *left, *right;

    Node(char c, int f) {
        ch = c;
        freq = f;
        left = right = NULL;
    }
};

// Comparator for min heap
struct cmp {
    bool operator()(Node* a, Node* b) {
        return a->freq > b->freq;
    }
};

// Build Huffman Tree
Node* buildHuffman(string s, vector<int>& freq) {
    priority_queue<Node*, vector<Node*>, cmp> pq;

    // Create leaf nodes
    for (int i = 0; i < (int)s.size(); i++) {
        pq.push(new Node(s[i], freq[i]));
    }

    // Build tree
    while (pq.size() > 1) {
        Node* l = pq.top(); pq.pop();
        Node* r = pq.top(); pq.pop();

        Node* parent = new Node(0, l->freq + r->freq); // internal node (no char)
        parent->left = l;
        parent->right = r;

        pq.push(parent);
    }

    return pq.top();
}

// Generate Huffman codes
void buildCodes(Node* root, string code, unordered_map<char, string>& mp) {
    if (!root) return;

    // If leaf node → store code
    if (!root->left && !root->right) {
        if (code == "") code = "0"; // single character case
        mp[root->ch] = code;
    }

    buildCodes(root->left, code + "0", mp);
    buildCodes(root->right, code + "1", mp);
}

// Encode string using Huffman codes
string encode(string text, unordered_map<char, string>& mp) {
    string res;
    for (char c : text) {
        res += mp[c];
    }
    return res;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    string s;
    cin >> s;

    vector<int> freq(n);
    for (int i = 0; i < n; i++) {
        cin >> freq[i];
    }

    Node* root = buildHuffman(s, freq);

    unordered_map<char, string> mp;
    buildCodes(root, "", mp);

    string text;
    cin >> text;

    cout << encode(text, mp) << "\n";

    return 0;
}
