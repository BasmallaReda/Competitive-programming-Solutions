// https://www.geeksforgeeks.org/problems/subset-sum-problem-1611555638/1 : Medium, DP
class Solution {
  public:
    int  neg=0, pos=0;//25
    bool fun(vector<int>& v, int ind, int sum,vector<vector<int>>& dp, int Sum)
    {
        if(sum==Sum) return true;
        if(ind<0) return false;
    
        if(dp[ind][sum+neg]!=-1)
            return dp[ind][sum+neg];
        bool take=fun(v,ind-1,sum-v[ind], dp, Sum);
        bool leave=true;//or false , never makes any change
        if(!take) leave=fun(v,ind-1,sum, dp, Sum);
        return dp[ind][sum+neg]=take||leave;
    }
    bool isSubsetSum(vector<int>& v, int sum) {
        int n=v.size(), m=0;
        for(int i=0;i<n;i++)
        {
            m+=v[i];
            if(v[i]<0)
                neg+=-v[i];
            else
                pos+=v[i];
        }
        vector<vector<int>> dp(n+1,vector<int>(neg+pos+1,-1));
        return fun(v,v.size()-1,m, dp, sum);
        
    }
};
