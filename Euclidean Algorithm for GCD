//recursion
int gcd(int a, int b)//b remainder, a coffecient, WORKS
{
    if(b==0)
        return a;
    return gcd(min(b, a), max(a, b)%min(b,a));
}

//iterative
int GCD(int a, int b)
{
    int g=max(a,b);
    int s=min(a,b);
    while(s)
    {
        int c=s;
        s=g%s;
        g=c;
    }
    return g;
}
