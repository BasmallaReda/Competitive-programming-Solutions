//Min Cost Climbing Stairs, DP
int helper(vector<int>& c, int ind,vector<int>&dp)
    {
        if(ind<=1)
            return 0;
        if(dp[ind-1]!=-1)
            return dp[ind-1];
        int S=c[ind-1]+helper(c,ind-1, dp);
        int SS=c[ind-2]+helper(c, ind-2, dp);
        return dp[ind-1]=min(S,SS);
    }
